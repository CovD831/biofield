{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biofield://schemas/meas0/synthetic-fault-suite/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "suite_id",
    "suite_version",
    "protocol_ref",
    "arms",
    "scenarios"
  ],
  "properties": {
    "schema_id": {
      "const": "biofield.meas0.synthetic_fault_suite"
    },
    "schema_version": {
      "const": "1"
    },
    "suite_id": {
      "const": "meas0.synthetic_faults"
    },
    "suite_version": {
      "const": "1"
    },
    "protocol_ref": {
      "const": "docs/experiments/EXPERIMENT_PROTOCOL.md#4.4"
    },
    "arms": {
      "const": [
        "self_eval",
        "judge_only",
        "state_only",
        "rules_state",
        "evaluation_plane"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "protocol_scenario",
        "fault_category",
        "expected_gold_status",
        "critical",
        "hard_gate",
        "safety_violation",
        "applicable_arms",
        "human_review_required",
        "signals"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^meas0\\.[a-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "protocol_scenario": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            },
            {
              "type": "null"
            }
          ]
        },
        "fault_category": {
          "enum": [
            "none",
            "clean_failure",
            "state_mismatch",
            "policy_violation",
            "provenance_conflict",
            "requirement_omission",
            "unauthorized_requirement_approval",
            "evaluator_tampering",
            "deterministic_fail_judge_override",
            "judge_instability",
            "semantic_residual",
            "insufficient_evidence",
            "schema_drift",
            "low_reliability",
            "metamorphic_instability",
            "duplicate_side_effect",
            "causal_misattribution",
            "evidence_ladder_gap"
          ]
        },
        "expected_gold_status": {
          "enum": ["pass", "fail", "unknown", "disputed", "invalid"]
        },
        "critical": {
          "type": "boolean"
        },
        "hard_gate": {
          "type": "boolean"
        },
        "safety_violation": {
          "type": "boolean"
        },
        "applicable_arms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "self_eval",
              "judge_only",
              "state_only",
              "rules_state",
              "evaluation_plane"
            ]
          }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "self_report",
            "evidence",
            "source",
            "trajectory",
            "state",
            "semantic"
          ],
          "properties": {
            "self_report": {"$ref": "#/$defs/signal"},
            "evidence": {"$ref": "#/$defs/signal"},
            "source": {"$ref": "#/$defs/signal"},
            "trajectory": {"$ref": "#/$defs/signal"},
            "state": {"$ref": "#/$defs/signal"},
            "semantic": {"$ref": "#/$defs/signal"}
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_value", "provenance_refs"],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "disputed",
            "invalid",
            "not_applicable"
          ]
        },
        "observed_value": {
          "type": "string",
          "minLength": 1
        },
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$"
          }
        }
      }
    }
  }
}
